def prompt_for_search_terms():
    print("Enter search terms or topic - use quotation marks for single search terms (one per line, blank line to finish):")
    terms = []
    while True:
        line = input().strip()
        if not line:
            break
        terms.append(line)
    if not terms:
        terms = ["digital culture"]  # Default term
    return terms

def prompt_for_journals():
    print("Enter journal names (one per line, blank line to finish, or just press Enter to use default list):")
    journals = []
    while True:
        line = input().strip()
        if not line:
            break
        journals.append(line)
    if not journals:
        journals = JOURNAL_LIST
    return journals

def prompt_for_save_path():
    path = input(f"Enter the folder path to save PDFs (default: {DEFAULT_SAVE_PATH}): ").strip()
    if not path:
        path = DEFAULT_SAVE_PATH
    if not os.path.exists(path):
        os.makedirs(path)
    return path

def scopus_search(query, journal, api_key, count=10):
    url = "https://api.elsevier.com/content/search/scopus"
    params = {
        "query": f'TITLE-ABS-KEY({query}) AND SRCTITLE(\"{journal}\")',
        "apiKey": api_key,
        "count": count
    }
    headers = {"Accept": "application/json"}
    resp = requests.get(url, params=params, headers=headers)
    resp.raise_for_status()
    return resp.json()

def get_pdf_link_from_unpaywall(doi):
    url = f"https://api.unpaywall.org/v2/{doi}?email={UNPAYWALL_EMAIL}"
    try:
        resp = requests.get(url)
        if resp.status_code == 200:
            data = resp.json()
            if data.get("best_oa_location") and data["best_oa_location"].get("url_for_pdf"):
                return data["best_oa_location"]["url_for_pdf"]
    except Exception as e:
        print(f"        Unpaywall error for DOI {doi}: {e}")
    return None

def download_pdf(url, save_folder, filename):
    local_filename = os.path.join(save_folder, filename)
    try:
        with requests.get(url, stream=True, timeout=15) as r:
            r.raise_for_status()
            with open(local_filename, 'wb') as f:
                for chunk in r.iter_content(chunk_size=8192):
                    f.write(chunk)
        return local_filename
    except Exception as e:
        print(f"        Failed to download {url}: {e}")
        return None

def save_undownloaded_to_csv(undownloaded_articles, save_folder):
    csv_path = os.path.join(save_folder, "undownloaded_articles.csv")
    with open(csv_path, mode='w', newline='', encoding='utf-8') as csvfile:
        writer = csv.writer(csvfile)
        writer.writerow(["Title", "Journal", "DOI", "Publisher Link"])
        for art in undownloaded_articles:
            writer.writerow([
                art['title'],
                art['journal'],
                art['doi'] if art['doi'] else '',
                art['publisher_link'] if art['publisher_link'] else ''
            ])
    print(f"\nUndownloaded articles saved to: {csv_path}")

def main():
    search_terms = prompt_for_search_terms()
    journals = prompt_for_journals()
    save_path = prompt_for_save_path()
    undownloaded_articles = []

    for term in search_terms:
        print(f"\nSearch term: '{term}'")
        for journal in journals:
            print(f"  Searching {journal} in Scopus...")
            try:
                results = scopus_search(term, journal, SCOPUS_API_KEY, count=10)
                entries = results.get("search-results", {}).get("entry", [])
                if not entries:
                    print(f"    No articles found.")
                    continue
                for entry in tqdm(entries, desc=f"    Processing articles from {journal}"):
                    title = entry.get("dc:title", "untitled")
                    doi = entry.get("prism:doi")
                    publisher_link = f"https://doi.org/{doi}" if doi else entry.get("prism:url")
                    if not doi:
                        print(f"      No DOI for article: {title}")
                        undownloaded_articles.append({
                            "title": title,
                            "journal": journal,
                            "doi": None,
                            "publisher_link": publisher_link
                        })
                        continue
                    pdf_url = get_pdf_link_from_unpaywall(doi)
                    if pdf_url:
                        filename = f"{doi.replace('/', '_')}.pdf"
                        downloaded = download_pdf(pdf_url, save_path, filename)
                        if downloaded:
                            print(f"      Saved: {downloaded}")
                        else:
                            print(f"      Could not download PDF for: {title}")
                            undownloaded_articles.append({
                                "title": title,
                                "journal": journal,
                                "doi": doi,
                                "publisher_link": publisher_link
                            })
                    else:
                        print(f"      No open-access PDF found for: {title}")
                        undownloaded_articles.append({
                            "title": title,
                            "journal": journal,
                            "doi": doi,
                            "publisher_link": publisher_link
                        })
            except Exception as e:
                print(f"    Error searching {journal}: {e}")

    # Print and save summary at the end
    if undownloaded_articles:
        print("\nArticles you need to download manually:")
        for art in undownloaded_articles:
            print(f"- {art['title']} ({art['journal']})")
            if art['doi']:
                print(f"  DOI: {art['doi']}")
                print(f"  Link: {art['publisher_link']}")
            else:
                print(f"  Publisher link: {art['publisher_link']}")
        save_undownloaded_to_csv(undownloaded_articles, save_path)
    else:
        print("\nAll articles were downloaded as open-access PDFs.")

if __name__ == "__main__":
    main()
